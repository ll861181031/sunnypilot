<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jixiexiaoge.drivingassist.navdiag"
    android:versionCode="24"
    android:versionName="0.7.5">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 采集包没有网络、开机自启或外部存储权限；定位只服务手动开启的本地只读桥。 -->
    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="CP导航原始采集"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PhoneCaptureService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:stopWithTask="false" />
        <service
            android:name=".BridgeService"
            android:exported="false"
            android:stopWithTask="false" />
        <service
            android:name=".GpsBridgeService"
            android:exported="true"
            android:foregroundServiceType="location"
            android:permission="android.permission.DUMP"
            android:stopWithTask="false" />
        <receiver
            android:name=".GpsBridgeCommandReceiver"
            android:exported="true" />
    </application>

    <instrumentation
        android:name=".PhoneCaptureInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="手机独立采集归档自测"
        android:targetPackage="com.jixiexiaoge.drivingassist.navdiag" />
    <instrumentation
        android:name=".CaptureInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="导航原始采集离线自测"
        android:targetPackage="com.jixiexiaoge.drivingassist.navdiag" />
    <instrumentation
        android:name=".BridgeInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="导航广播观测桥离线自测"
        android:targetPackage="com.jixiexiaoge.drivingassist.navdiag" />
    <instrumentation
        android:name=".NativeProbeInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="只读路线身份探针离线自测"
        android:targetPackage="com.jixiexiaoge.drivingassist.navdiag" />
    <instrumentation
        android:name=".AndroidGpsProbeInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="只读GPS缓存探针离线自测"
        android:targetPackage="com.jixiexiaoge.drivingassist.navdiag" />
    <instrumentation
        android:name=".GpsBridgeInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="前台GPS桥离线自测"
        android:targetPackage="com.jixiexiaoge.drivingassist.navdiag" />
</manifest>
